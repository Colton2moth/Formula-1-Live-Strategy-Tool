# Copy to frontend/.env to prefill the replay controls. Vite only exposes
# variables prefixed with VITE_ to the client.

# Prefill the replay "Session key" input (leave unset to type it each time)
# VITE_REPLAY_SESSION_KEY=9979

# Prefill the replay "Speed" input (default 10)
# VITE_REPLAY_SPEED=10

# Backend origin when NOT using the dev proxy (default: same-origin proxy)
# VITE_API_BASE_URL=http://127.0.0.1:8000
