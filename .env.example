# Copy to .env and fill in. NEVER commit .env.
# OPENF1_BASE_URL=https://api.openf1.org/v1

# OpenF1 paid auth — username/password exchanged for a Bearer token at /token
# OPENF1_USERNAME=your_email@example.com
# OPENF1_PASSWORD=your_password

# Frontend origin (no trailing slash). Enables CORS for browser calls.
# Local Vite: http://localhost:5173
# Deployed:   https://your-app.onrender.com
# FRONTEND_URL=http://localhost:5173

# Directory of trained prediction models used for live inference.
# INFERENCE_MODEL_DIR=data/models

# Start OpenF1 MQTT listener inside the API process (1=on, 0=off)
# LIVE_MQTT=1

# Pull REST snapshot into LIVE_STATE on API startup (1=on, 0=off)
# LIVE_BOOTSTRAP=1

