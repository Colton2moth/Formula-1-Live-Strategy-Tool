# Copy to .env and fill in. NEVER commit .env.
# OPENF1_BASE_URL=https://api.openf1.org/v1

# OpenF1 paid auth — username/password exchanged for a Bearer token at /token
# OPENF1_USERNAME=your_email@example.com
# OPENF1_PASSWORD=your_password

# Deployed frontend origin (no trailing slash). Enables CORS for browser calls.
# FRONTEND_URL=https://your-app.onrender.com

# Historical snapshot used by /api/predictions (model inference, not live yet)
# INFERENCE_CSV=data/processed/driver_laps_all.csv
# INFERENCE_MODEL_DIR=data/models
# INFERENCE_SESSION_KEY=9979
# INFERENCE_LAP=20

# Start OpenF1 MQTT listener inside the API process (1=on, 0=off)
# LIVE_MQTT=1

# Pull REST snapshot into LIVE_STATE on API startup (1=on, 0=off)
# LIVE_BOOTSTRAP=1
